rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function trip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isParticipant(tripData) {
      return signedIn() && tripData.memberIds.hasAny([request.auth.uid]);
    }

    function isOwner(tripData) {
      return signedIn() &&
        tripData.ownerId == request.auth.uid &&
        tripData.memberRoles[request.auth.uid] == 'owner';
    }

    function isEditor(tripData) {
      return signedIn() &&
        request.auth.uid in tripData.memberRoles &&
        tripData.memberRoles[request.auth.uid] == 'editor';
    }

    function isPublicTrip(tripData) {
      return tripData.visibility == 'profile' && tripData.status == 'active';
    }

    function isActiveTrip(tripId) {
      return trip(tripId).status == 'active';
    }

    function validUsername(username) {
      return username is string &&
        username.size() >= 3 &&
        username.size() <= 30 &&
        username.matches('^[a-z0-9_]+$');
    }

    function validPlanTime(time) {
      return time is map &&
        (
          (
            time.kind == 'date' &&
            time.keys().hasOnly(['kind', 'localDate']) &&
            time.localDate is string &&
            time.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          ) ||
          (
            time.kind == 'timed' &&
            time.keys().hasOnly([
              'kind',
              'startsAt',
              'endsAt',
              'startTimeZone',
              'endTimeZone'
            ]) &&
            time.startsAt is string &&
            time.endsAt is string &&
            time.startTimeZone is string &&
            time.endTimeZone is string &&
            time.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}Z$') &&
            time.endsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}Z$') &&
            time.endsAt >= time.startsAt &&
            time.startTimeZone.matches('^[A-Za-z_]+(/[-A-Za-z0-9_+]+)+$') &&
            time.endTimeZone.matches('^[A-Za-z_]+(/[-A-Za-z0-9_+]+)+$')
          )
        );
    }

    function validTripMembership(tripData) {
      return tripData.memberIds is list &&
        tripData.memberRoles is map &&
        tripData.memberIds.hasAll([tripData.ownerId]) &&
        tripData.memberRoles.keys().hasOnly(tripData.memberIds) &&
        tripData.memberIds.hasOnly(tripData.memberRoles.keys()) &&
        tripData.memberRoles.values().hasOnly(['owner', 'editor', 'viewer']) &&
        tripData.memberRoles[tripData.ownerId] == 'owner';
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        validUsername(request.resource.data.username) &&
        getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == userId;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    match /accounts/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() &&
        validUsername(username) &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isParticipant(resource.data) || isPublicTrip(resource.data);
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        validTripMembership(request.resource.data) &&
        request.resource.data.visibility in ['private', 'profile'] &&
        request.resource.data.status == 'active';
      allow update: if
        (
          isOwner(resource.data) &&
          resource.data.status == 'active' &&
          request.resource.data.ownerId == resource.data.ownerId &&
          validTripMembership(request.resource.data) &&
          request.resource.data.visibility in ['private', 'profile'] &&
          request.resource.data.status in ['active', 'archived']
        ) ||
        (
          resource.data.status == 'active' &&
          isEditor(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'locationName',
            'visibility',
            'startDate',
            'endDate',
            'coverImageUrl',
            'updatedAt'
          ])
        );
      allow delete: if false;

      match /planItems/{planItemId} {
        allow read: if isParticipant(trip(tripId)) ||
          (isPublicTrip(trip(tripId)) && resource.data.visibility == 'profile');
        allow create: if isActiveTrip(tripId) &&
          (isOwner(trip(tripId)) || isEditor(trip(tripId))) &&
          request.resource.data.visibility in ['trip', 'profile'] &&
          validPlanTime(request.resource.data.time);
        allow update: if isActiveTrip(tripId) &&
          (isOwner(trip(tripId)) || isEditor(trip(tripId))) &&
          request.resource.data.visibility in ['trip', 'profile'] &&
          validPlanTime(request.resource.data.time);
        allow delete: if isActiveTrip(tripId) &&
          (isOwner(trip(tripId)) || isEditor(trip(tripId)));
      }
    }

    match /expenses/{expenseId} {
      allow read: if
        (signedIn() && resource.data.ownerId == request.auth.uid) ||
        (
          isParticipant(trip(resource.data.tripId)) &&
          resource.data.visibility in ['trip', 'profile']
        ) ||
        (
          isPublicTrip(trip(resource.data.tripId)) &&
          resource.data.visibility == 'profile'
        );
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId) &&
        (!('kind' in request.resource.data) ||
          request.resource.data.kind in ['planned', 'spent', 'income']) &&
        request.resource.data.visibility in ['private', 'trip', 'profile'];
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.tripId == resource.data.tripId &&
        (!('kind' in request.resource.data) ||
          request.resource.data.kind in ['planned', 'spent', 'income']) &&
        request.resource.data.visibility in ['private', 'trip', 'profile'];
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid;
    }

    match /preparationItems/{itemId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId);
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid;
    }

    match /tripSettings/{settingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId);
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.userId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.acceptedBy &&
        request.resource.data.memberIds.size() == 2 &&
        get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toId == request.auth.uid &&
        request.resource.data.memberIds.hasAll([
          get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromId,
          get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toId
        ]);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }
  }
}
