rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function trip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isParticipant(tripData) {
      return signedIn() && tripData.memberIds.hasAny([request.auth.uid]);
    }

    function isOwner(tripData) {
      return signedIn() &&
        tripData.ownerId == request.auth.uid &&
        tripData.memberRoles[request.auth.uid] == 'owner';
    }

    function isEditor(tripData) {
      return signedIn() &&
        request.auth.uid in tripData.memberRoles &&
        tripData.memberRoles[request.auth.uid] == 'editor';
    }

    function isPublicTrip(tripData) {
      return tripData.visibility == 'profile' && tripData.status == 'active';
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == userId;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    match /accounts/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isParticipant(resource.data) || isPublicTrip(resource.data);
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberRoles[request.auth.uid] == 'owner' &&
        request.auth.uid in request.resource.data.memberRoles &&
        request.resource.data.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.status == 'active';
      allow update: if
        (
          isOwner(resource.data) &&
          resource.data.status == 'active' &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.memberRoles[resource.data.ownerId] == 'owner' &&
          request.resource.data.status in ['active', 'archived']
        ) ||
        (
          resource.data.status == 'active' &&
          isEditor(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'locationName',
            'visibility',
            'startDate',
            'endDate',
            'coverImageUrl',
            'updatedAt'
          ])
        );
      allow delete: if false;

      match /planItems/{planItemId} {
        allow read: if isParticipant(trip(tripId)) ||
          (isPublicTrip(trip(tripId)) && resource.data.visibility == 'profile');
        allow create, update, delete: if trip(tripId).status == 'active' &&
          (isOwner(trip(tripId)) || isEditor(trip(tripId)));
      }
    }

    match /expenses/{expenseId} {
      allow read: if
        (signedIn() && resource.data.ownerId == request.auth.uid) ||
        (
          isParticipant(trip(resource.data.tripId)) &&
          resource.data.visibility in ['trip', 'profile']
        ) ||
        (
          isPublicTrip(trip(resource.data.tripId)) &&
          resource.data.visibility == 'profile'
        );
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId));
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /preparationItems/{itemId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /tripSettings/{settingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.acceptedBy &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2 &&
        get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }
  }
}
