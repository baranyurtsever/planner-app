rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function trip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isParticipant(tripData) {
      return signedIn() && tripData.memberIds.hasAny([request.auth.uid]);
    }

    function isOwner(tripData) {
      return signedIn() &&
        tripData.ownerId == request.auth.uid &&
        tripData.memberRoles[request.auth.uid] == 'owner';
    }

    function isEditor(tripData) {
      return signedIn() &&
        request.auth.uid in tripData.memberRoles &&
        tripData.memberRoles[request.auth.uid] == 'editor';
    }

    function isPublicTrip(tripData) {
      return tripData.visibility == 'profile' && tripData.status == 'active';
    }

    function canManagePublicTrip(tripId) {
      return isOwner(getAfter(/databases/$(database)/documents/trips/$(tripId)).data) ||
        isEditor(getAfter(/databases/$(database)/documents/trips/$(tripId)).data);
    }

    function validPublicTripProjection(tripId, projectionData) {
      let source = getAfter(/databases/$(database)/documents/trips/$(tripId)).data;
      return projectionData.keys().hasOnly([
          'name',
          'locationName',
          'visibility',
          'status',
          'startDate',
          'endDate',
          'coverImageUrl',
          'updatedAt'
        ]) &&
        projectionData.name == source.name &&
        projectionData.locationName == source.locationName &&
        projectionData.visibility == 'profile' &&
        projectionData.status == 'active' &&
        source.visibility == 'profile' &&
        source.status == 'active';
    }

    function isActiveTrip(tripId) {
      return trip(tripId).status == 'active';
    }

    function planItem(tripId, planItemId) {
      return get(
        /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
      ).data;
    }

    function departurePath(tripId, planItemId, userId) {
      return /databases/$(database)/documents/trips/$(tripId)/planDepartures/$(planItemId + '_' + userId);
    }

    function hasDeparted(tripId, planItemId, userId) {
      return exists(departurePath(tripId, planItemId, userId));
    }

    function hasDepartedAfter(tripId, planItemId, userId) {
      return existsAfter(departurePath(tripId, planItemId, userId));
    }

    function publicPlanIsSyncedAfter(tripId, planItemId, planData) {
      let publicPath = /databases/$(database)/documents/trips/$(tripId)/publicPlanItems/$(planItemId);
      return (
          planData.visibility == 'profile' &&
          existsAfter(publicPath) &&
          getAfter(publicPath).data.scope == planData.scope &&
          getAfter(publicPath).data.title == planData.title &&
          getAfter(publicPath).data.category == planData.category &&
          getAfter(publicPath).data.status == planData.status &&
          getAfter(publicPath).data.visibility == planData.visibility &&
          getAfter(publicPath).data.notes == planData.notes &&
          getAfter(publicPath).data.location == planData.location &&
          getAfter(publicPath).data.time == planData.time
        ) ||
        (planData.visibility != 'profile' && !existsAfter(publicPath));
    }

    function validUsername(username) {
      return username is string &&
        username.size() >= 3 &&
        username.size() <= 30 &&
        username.matches('^[a-z0-9_]+$');
    }

    function validPlanTime(time) {
      return time is map &&
        (
          (
            time.kind == 'date' &&
            time.keys().hasOnly(['kind', 'localDate']) &&
            time.localDate is string &&
            time.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            timestamp.value(time.localDate + 'T00:00:00Z') is timestamp
          ) ||
          (
            time.kind == 'timed' &&
            time.keys().hasOnly([
              'kind',
              'startsAt',
              'endsAt',
              'startTimeZone',
              'endTimeZone'
            ]) &&
            time.startsAt is string &&
            time.endsAt is string &&
            time.startTimeZone is string &&
            time.endTimeZone is string &&
            time.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:(00|15|30|45):00[.]000Z$') &&
            time.endsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:(00|15|30|45):00[.]000Z$') &&
            timestamp.value(time.endsAt) >= timestamp.value(time.startsAt) + duration.value(15, 'm') &&
            time.startTimeZone.matches('^[A-Za-z_]+(/[-A-Za-z0-9_+]+)+$') &&
            time.endTimeZone.matches('^[A-Za-z_]+(/[-A-Za-z0-9_+]+)+$')
          )
        );
    }

    function isSharedPlanItem(planData) {
      return !('scope' in planData) || planData.scope == 'shared';
    }

    function isPersonalPlanItem(planData) {
      return 'scope' in planData && planData.scope == 'personal';
    }

    function validPlanItem(planData) {
      return planData.title is string &&
        planData.title.size() > 0 &&
        planData.category in [
          'flight',
          'stay',
          'transport',
          'food',
          'museum',
          'activity',
          'entertainment',
          'shopping',
          'health',
          'other'
        ] &&
        planData.status in ['todo', 'done', 'postponed', 'cancelled'] &&
        planData.visibility in ['private', 'trip', 'profile'] &&
        validPlanTime(planData.time) &&
        (
          (
            isSharedPlanItem(planData) &&
            planData.visibility in ['trip', 'profile']
          ) ||
          (
            isPersonalPlanItem(planData) &&
            planData.ownerId is string &&
            planData.participantIds is list &&
            planData.participantIds.hasAny([planData.ownerId])
          )
        );
    }

    function validPersonalMembership(tripData, planData) {
      return !isPersonalPlanItem(planData) ||
        (
          planData.participantIds.hasOnly(tripData.memberIds) &&
          planData.blockedParticipantIds.hasOnly(tripData.memberIds) &&
          !planData.participantIds.hasAny(planData.blockedParticipantIds) &&
          (
            planData.visibility != 'private' ||
            (
              planData.participantIds.size() == 1 &&
              planData.participantIds.hasAny([planData.ownerId])
            )
          )
        );
    }

    function validSharedProposalPatch(patch) {
      return patch is map &&
        patch.keys().hasOnly([
          'title',
          'category',
          'status',
          'visibility',
          'notes',
          'location',
          'time'
        ]) &&
        (!('title' in patch) || (patch.title is string && patch.title.size() > 0)) &&
        (!('category' in patch) || patch.category in [
          'flight',
          'stay',
          'transport',
          'food',
          'museum',
          'activity',
          'entertainment',
          'shopping',
          'health',
          'other'
        ]) &&
        (!('status' in patch) || patch.status in ['todo', 'done', 'postponed', 'cancelled']) &&
        (!('visibility' in patch) || patch.visibility in ['trip', 'profile']) &&
        (!('notes' in patch) || patch.notes is string) &&
        (!('location' in patch) || patch.location is map) &&
        (!('time' in patch) || validPlanTime(patch.time));
    }

    function proposalPatchApplied(planData, patch) {
      return (!('title' in patch) || planData.title == patch.title) &&
        (!('category' in patch) || planData.category == patch.category) &&
        (!('status' in patch) || planData.status == patch.status) &&
        (!('visibility' in patch) || planData.visibility == patch.visibility) &&
        (!('notes' in patch) || planData.notes == patch.notes) &&
        (!('location' in patch) || planData.location == patch.location) &&
        (!('time' in patch) || planData.time == patch.time);
    }

    function proposalAppliedAfter(tripId, proposalData) {
      let targetPath = /databases/$(database)/documents/trips/$(tripId)/planItems/$(proposalData.targetItemId);
      return (
          proposalData.action == 'delete' &&
          !existsAfter(targetPath)
        ) ||
        (
          proposalData.action in ['create', 'update'] &&
          existsAfter(targetPath) &&
          isSharedPlanItem(getAfter(targetPath).data) &&
          validPlanItem(getAfter(targetPath).data) &&
          proposalPatchApplied(getAfter(targetPath).data, proposalData.patch)
        );
    }

    function validProposalAction(tripId, proposalData) {
      let targetPath = /databases/$(database)/documents/trips/$(tripId)/planItems/$(proposalData.targetItemId);
      return proposalData.action in ['create', 'update', 'delete'] &&
        proposalData.targetItemId is string &&
        proposalData.patch is map &&
        (
          (
            proposalData.action == 'create' &&
            isSharedPlanItem(proposalData.patch) &&
            validPlanItem(proposalData.patch)
          ) ||
          (
            proposalData.action == 'update' &&
            validSharedProposalPatch(proposalData.patch) &&
            exists(targetPath) &&
            isSharedPlanItem(get(targetPath).data)
          ) ||
          (
            proposalData.action == 'delete' &&
            proposalData.patch.keys().size() == 0 &&
            exists(targetPath) &&
            isSharedPlanItem(get(targetPath).data)
          )
        );
    }

    function validTripMembership(tripData) {
      return tripData.memberIds is list &&
        tripData.memberRoles is map &&
        tripData.memberIds.hasAll([tripData.ownerId]) &&
        tripData.memberRoles.keys().hasOnly(tripData.memberIds) &&
        tripData.memberIds.hasOnly(tripData.memberRoles.keys()) &&
        tripData.memberRoles.values().hasOnly(['owner', 'editor', 'viewer']) &&
        tripData.memberRoles[tripData.ownerId] == 'owner';
    }

    function validTripInvitation(invitationId, invitationData) {
      return invitationData.keys().hasOnly([
          'tripId',
          'tripName',
          'inviterId',
          'inviteeId',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        invitationData.tripId is string &&
        invitationData.tripName is string &&
        invitationData.inviterId is string &&
        invitationData.inviteeId is string &&
        invitationData.role in ['editor', 'viewer'] &&
        invitationData.status in ['pending', 'accepted', 'rejected', 'cancelled'] &&
        invitationId == invitationData.tripId + '_' + invitationData.inviteeId;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        validUsername(request.resource.data.username) &&
        getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == userId;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.username == resource.data.username;
      allow delete: if false;

      match /publicTrips/{tripId} {
        allow read: if true;
        allow create, update: if canManagePublicTrip(tripId) &&
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberIds.hasAny([userId]) &&
          validPublicTripProjection(tripId, request.resource.data);
        allow delete: if canManagePublicTrip(tripId);
      }
    }

    match /accounts/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() &&
        validUsername(username) &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        validTripMembership(request.resource.data) &&
        request.resource.data.visibility in ['private', 'profile'] &&
        request.resource.data.status == 'active';
      allow update: if
        (
          isOwner(resource.data) &&
          resource.data.status == 'active' &&
          request.resource.data.ownerId == resource.data.ownerId &&
          validTripMembership(request.resource.data) &&
          request.resource.data.visibility in ['private', 'profile'] &&
          request.resource.data.status in ['active', 'archived']
        ) ||
        (
          resource.data.status == 'active' &&
          !resource.data.memberIds.hasAny([request.auth.uid]) &&
          validTripMembership(request.resource.data) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.resource.data.memberIds.hasAny([request.auth.uid]) &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.memberRoles.diff(resource.data.memberRoles).affectedKeys().hasOnly([request.auth.uid]) &&
          existsAfter(/databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)).data.status == 'accepted' &&
          getAfter(/databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)).data.inviteeId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)).data.role == request.resource.data.memberRoles[request.auth.uid] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds',
            'memberRoles',
            'updatedAt'
          ])
        ) ||
        (
          resource.data.status == 'active' &&
          isEditor(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'locationName',
            'visibility',
            'startDate',
            'endDate',
            'coverImageUrl',
            'updatedAt'
          ])
        );
      allow delete: if false;

      match /planItems/{planItemId} {
        allow read: if
          (
            isPersonalPlanItem(resource.data) &&
            resource.data.visibility == 'private' &&
            signedIn() &&
            resource.data.ownerId == request.auth.uid
          ) ||
          (
            resource.data.visibility in ['trip', 'profile'] &&
            isParticipant(trip(tripId))
          );
        allow create: if isActiveTrip(tripId) &&
          isParticipant(trip(tripId)) &&
          validPlanItem(request.resource.data) &&
          validPersonalMembership(trip(tripId), request.resource.data) &&
          publicPlanIsSyncedAfter(tripId, planItemId, request.resource.data) &&
          (
            (isSharedPlanItem(request.resource.data) && isOwner(trip(tripId))) ||
            (
              isPersonalPlanItem(request.resource.data) &&
              request.resource.data.ownerId == request.auth.uid
            )
          );
        allow update: if isActiveTrip(tripId) &&
          publicPlanIsSyncedAfter(tripId, planItemId, request.resource.data) &&
          (
            (
              validPlanItem(request.resource.data) &&
              isSharedPlanItem(resource.data) &&
              isSharedPlanItem(request.resource.data) &&
              isOwner(trip(tripId))
            ) ||
            (
              validPlanItem(request.resource.data) &&
              validPersonalMembership(trip(tripId), request.resource.data) &&
              isPersonalPlanItem(resource.data) &&
              isPersonalPlanItem(request.resource.data) &&
              resource.data.ownerId == request.auth.uid &&
              request.resource.data.ownerId == resource.data.ownerId &&
              (
                !('blockedParticipantIds' in resource.data) ||
                !request.resource.data.participantIds.hasAny(resource.data.blockedParticipantIds)
              )
            ) ||
            (
              isSharedPlanItem(resource.data) &&
              isParticipant(trip(tripId)) &&
              (!('createdBy' in resource.data) || resource.data.createdBy != request.auth.uid) &&
              hasDepartedAfter(tripId, planItemId, request.auth.uid) &&
              request.resource.data.excludedParticipantIds.hasAny([request.auth.uid]) &&
              (
                (
                  !('excludedParticipantIds' in resource.data) &&
                  request.resource.data.excludedParticipantIds.size() == 1
                ) ||
                (
                  !resource.data.excludedParticipantIds.hasAny([request.auth.uid]) &&
                  request.resource.data.excludedParticipantIds.hasAll(resource.data.excludedParticipantIds) &&
                  request.resource.data.excludedParticipantIds.size() ==
                    resource.data.excludedParticipantIds.size() + 1
                )
              ) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'excludedParticipantIds',
                'updatedAt'
              ])
            ) ||
            (
              isPersonalPlanItem(resource.data) &&
              resource.data.ownerId != request.auth.uid &&
              hasDepartedAfter(tripId, planItemId, request.auth.uid) &&
              resource.data.participantIds.hasAny([request.auth.uid]) &&
              !request.resource.data.participantIds.hasAny([request.auth.uid]) &&
              request.resource.data.participantIds.hasAll(
                resource.data.participantIds.removeAll([request.auth.uid])
              ) &&
              request.resource.data.participantIds.size() ==
                resource.data.participantIds.size() - 1 &&
              request.resource.data.blockedParticipantIds.hasAny([request.auth.uid]) &&
              (
                !('blockedParticipantIds' in resource.data) ||
                request.resource.data.blockedParticipantIds.hasAll(resource.data.blockedParticipantIds)
              ) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'participantIds',
                'blockedParticipantIds',
                'updatedAt'
              ])
            ) ||
            (
              validPlanItem(request.resource.data) &&
              validPersonalMembership(trip(tripId), request.resource.data) &&
              isPersonalPlanItem(resource.data) &&
              isOwner(trip(tripId)) &&
              request.resource.data.ownerId == resource.data.ownerId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'participantIds',
                'blockedParticipantIds',
                'excludedParticipantIds',
                'updatedAt'
              ])
            )
          );
        allow delete: if isActiveTrip(tripId) &&
          !existsAfter(/databases/$(database)/documents/trips/$(tripId)/publicPlanItems/$(planItemId)) &&
          (
            (isSharedPlanItem(resource.data) && isOwner(trip(tripId))) ||
            (isPersonalPlanItem(resource.data) && resource.data.ownerId == request.auth.uid)
          );
      }

      match /publicPlanItems/{planItemId} {
        allow read: if isParticipant(trip(tripId)) ||
          (
            isPublicTrip(trip(tripId)) &&
            exists(/databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)) &&
            planItem(tripId, planItemId).visibility == 'profile'
          );
        allow create, update: if isActiveTrip(tripId) &&
          request.resource.data.keys().hasOnly([
            'scope',
            'title',
            'category',
            'status',
            'visibility',
            'notes',
            'location',
            'time',
            'updatedAt'
          ]) &&
          request.resource.data.visibility == 'profile' &&
          validPlanTime(request.resource.data.time) &&
          getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.visibility == 'profile' &&
          request.resource.data.scope == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.scope &&
          request.resource.data.title == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.title &&
          request.resource.data.category == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.category &&
          request.resource.data.status == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.status &&
          request.resource.data.notes == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.notes &&
          request.resource.data.location == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.location &&
          request.resource.data.time == getAfter(
            /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
          ).data.time &&
          (
            (
              isSharedPlanItem(getAfter(
                /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
              ).data) &&
              isOwner(trip(tripId))
            ) ||
            (
              isPersonalPlanItem(getAfter(
                /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
              ).data) &&
              getAfter(
                /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
              ).data.ownerId == request.auth.uid
            )
          );
        allow delete: if isActiveTrip(tripId) &&
          (
            isOwner(trip(tripId)) ||
            (
              exists(/databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)) &&
              isPersonalPlanItem(planItem(tripId, planItemId)) &&
              planItem(tripId, planItemId).ownerId == request.auth.uid
            ) ||
            (
              existsAfter(/databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)) &&
              isPersonalPlanItem(getAfter(
                /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
              ).data) &&
              getAfter(
                /databases/$(database)/documents/trips/$(tripId)/planItems/$(planItemId)
              ).data.ownerId == request.auth.uid
            )
          );
      }

      match /planChangeProposals/{proposalId} {
        allow read: if isParticipant(trip(tripId));
        allow create: if isActiveTrip(tripId) &&
          isEditor(trip(tripId)) &&
          request.resource.data.proposerId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          validProposalAction(tripId, request.resource.data);
        allow update: if isActiveTrip(tripId) &&
          (
            (
              isOwner(trip(tripId)) &&
              resource.data.status == 'pending' &&
              request.resource.data.status in ['approved', 'rejected'] &&
              request.resource.data.decidedBy == request.auth.uid &&
              (
                request.resource.data.status == 'rejected' ||
                proposalAppliedAfter(tripId, resource.data)
              ) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'decidedBy',
                'decidedAt'
              ])
            ) ||
            (
              isEditor(trip(tripId)) &&
              resource.data.proposerId == request.auth.uid &&
              request.resource.data.proposerId == resource.data.proposerId &&
              request.resource.data.targetItemId == resource.data.targetItemId &&
              (
                (
                  resource.data.status == 'pending' &&
                  request.resource.data.status == 'pending' &&
                  validProposalAction(tripId, request.resource.data) &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'action',
                    'patch',
                    'updatedAt'
                  ])
                ) ||
                (
                  resource.data.status == 'pending' &&
                  request.resource.data.action == resource.data.action &&
                  request.resource.data.status == 'withdrawn' &&
                  request.resource.data.withdrawnBy == request.auth.uid &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'status',
                    'withdrawnBy',
                    'decidedAt'
                  ])
                ) ||
                (
                  resource.data.status != 'pending' &&
                  request.resource.data.status == 'pending' &&
                  validProposalAction(tripId, request.resource.data) &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'action',
                    'patch',
                    'status',
                    'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if false;
      }

      match /planParticipationRequests/{participationRequestId} {
        allow read: if isParticipant(trip(tripId));
        allow create: if isActiveTrip(tripId) &&
          isParticipant(trip(tripId)) &&
          request.resource.data.requesterId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.planItemId is string &&
          isPersonalPlanItem(planItem(tripId, request.resource.data.planItemId)) &&
          planItem(tripId, request.resource.data.planItemId).ownerId ==
            request.resource.data.itemOwnerId &&
          planItem(tripId, request.resource.data.planItemId).visibility in ['trip', 'profile'] &&
          !planItem(tripId, request.resource.data.planItemId).participantIds.hasAny([request.auth.uid]) &&
          !planItem(tripId, request.resource.data.planItemId).blockedParticipantIds.hasAny([request.auth.uid]);
        allow update: if isActiveTrip(tripId) &&
          (
            (
              resource.data.status == 'pending' &&
              planItem(tripId, resource.data.planItemId).ownerId == request.auth.uid &&
              request.resource.data.status in ['approved', 'rejected'] &&
              request.resource.data.decidedBy == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'decidedBy',
                'decidedAt'
              ])
            ) ||
            (
              resource.data.status == 'rejected' &&
              resource.data.requesterId == request.auth.uid &&
              request.resource.data.requesterId == resource.data.requesterId &&
              request.resource.data.planItemId == resource.data.planItemId &&
              request.resource.data.itemOwnerId == resource.data.itemOwnerId &&
              request.resource.data.status == 'pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'updatedAt'
              ]) &&
              !planItem(tripId, resource.data.planItemId).participantIds.hasAny([request.auth.uid]) &&
              !planItem(tripId, resource.data.planItemId).blockedParticipantIds.hasAny([request.auth.uid])
            )
          );
        allow delete: if false;
      }

      match /planParticipantDetails/{detailId} {
        allow read: if signedIn() &&
          detailId.matches('^.*_' + request.auth.uid + '$') &&
          (
            resource == null ||
            !hasDeparted(tripId, resource.data.planItemId, request.auth.uid)
          );
        allow create: if isActiveTrip(tripId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.planItemId is string &&
          !hasDeparted(tripId, request.resource.data.planItemId, request.auth.uid) &&
          (
            (
              isSharedPlanItem(planItem(tripId, request.resource.data.planItemId)) &&
              !planItem(tripId, request.resource.data.planItemId)
                .excludedParticipantIds.hasAny([request.auth.uid])
            ) ||
            (
              isPersonalPlanItem(planItem(tripId, request.resource.data.planItemId)) &&
              planItem(tripId, request.resource.data.planItemId)
                .participantIds.hasAny([request.auth.uid])
            )
          );
        allow update: if isActiveTrip(tripId) &&
          resource.data.userId == request.auth.uid &&
          !hasDeparted(tripId, resource.data.planItemId, request.auth.uid) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.planItemId == resource.data.planItemId;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }

      match /planDepartures/{departureId} {
        allow read: if isParticipant(trip(tripId));
        allow create: if isActiveTrip(tripId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.planItemId is string &&
          departureId == request.resource.data.planItemId + '_' + request.auth.uid &&
          (
            !('createdBy' in planItem(tripId, request.resource.data.planItemId)) ||
            planItem(tripId, request.resource.data.planItemId).createdBy != request.auth.uid
          ) &&
          (
            !isPersonalPlanItem(planItem(tripId, request.resource.data.planItemId)) ||
            planItem(tripId, request.resource.data.planItemId).ownerId != request.auth.uid
          ) &&
          !exists(departurePath(tripId, request.resource.data.planItemId, request.auth.uid));
        allow update: if false;
        allow delete: if isOwner(trip(tripId));
      }
    }

    match /tripInvitations/{invitationId} {
      allow read: if signedIn() &&
        (
          resource == null ||
          resource.data.inviterId == request.auth.uid ||
          resource.data.inviteeId == request.auth.uid
        );
      allow create: if signedIn() &&
        validTripInvitation(invitationId, request.resource.data) &&
        request.resource.data.inviterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        isOwner(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId) &&
        !trip(request.resource.data.tripId).memberIds.hasAny([request.resource.data.inviteeId]) &&
        exists(/databases/$(database)/documents/profiles/$(request.resource.data.inviteeId));
      allow update: if signedIn() &&
        validTripInvitation(invitationId, request.resource.data) &&
        request.resource.data.tripId == resource.data.tripId &&
        request.resource.data.tripName == resource.data.tripName &&
        request.resource.data.inviterId == resource.data.inviterId &&
        request.resource.data.inviteeId == resource.data.inviteeId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (
            request.auth.uid == resource.data.inviteeId &&
            resource.data.status == 'pending' &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status in ['accepted', 'rejected'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            (
              request.resource.data.status == 'rejected' ||
              (
                getAfter(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.memberIds.hasAny([request.auth.uid]) &&
                getAfter(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.memberRoles[request.auth.uid] == resource.data.role
              )
            )
          ) ||
          (
            isOwner(trip(resource.data.tripId)) &&
            request.resource.data.status in ['pending', 'cancelled'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /publicTrips/{tripId} {
      allow read: if true;
      allow create, update: if canManagePublicTrip(tripId) &&
        validPublicTripProjection(tripId, request.resource.data);
      allow delete: if canManagePublicTrip(tripId);
    }

    match /expenses/{expenseId} {
      allow read: if
        (
          !('planItemId' in resource.data) ||
          !hasDeparted(resource.data.tripId, resource.data.planItemId, resource.data.ownerId)
        ) &&
        (
          (signedIn() && resource.data.ownerId == request.auth.uid) ||
          (
            isParticipant(trip(resource.data.tripId)) &&
            resource.data.visibility in ['trip', 'profile']
          ) ||
          (
            isPublicTrip(trip(resource.data.tripId)) &&
            resource.data.visibility == 'profile'
          )
        );
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (
          !('planItemId' in request.resource.data) ||
          !hasDepartedAfter(
            request.resource.data.tripId,
            request.resource.data.planItemId,
            request.auth.uid
          )
        ) &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId) &&
        (!('kind' in request.resource.data) ||
          request.resource.data.kind in ['planned', 'spent', 'income']) &&
        request.resource.data.visibility in ['private', 'trip', 'profile'];
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.tripId == resource.data.tripId &&
        (!('kind' in request.resource.data) ||
          request.resource.data.kind in ['planned', 'spent', 'income']) &&
        request.resource.data.visibility in ['private', 'trip', 'profile'];
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid;
    }

    match /preparationItems/{itemId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId);
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.ownerId == request.auth.uid;
    }

    match /tripSettings/{settingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isParticipant(trip(request.resource.data.tripId)) &&
        isActiveTrip(request.resource.data.tripId);
      allow update: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() &&
        isActiveTrip(resource.data.tripId) &&
        resource.data.userId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.acceptedBy &&
        request.resource.data.memberIds.size() == 2 &&
        get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toId == request.auth.uid &&
        request.resource.data.memberIds.hasAll([
          get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromId,
          get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toId
        ]);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }
  }
}
